# Connection string do Session Pooler do Supabase (Project Settings > Database >
# Connection string > aba "Session pooler", porta 5432 — NÃO a de conexão direta,
# que só resolve por IPv6). Scheme precisa ser postgresql+psycopg:// (driver psycopg3).
# Se não definida, o app usa SQLite local (DB_PATH) automaticamente.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Usado apenas quando DATABASE_URL não está definida.
DB_PATH=database.db
